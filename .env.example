# ─── Base de datos ───────────────────────────────────────────────
# Local (Docker):  mongodb://127.0.0.1:27017/coffee_geeks
# Atlas (Vercel):  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/coffee_geeks?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/coffee_geeks"

# ─── Sesiones (JWT) ──────────────────────────────────────────────
# Generar con: openssl rand -base64 32
JWT_SECRET=""

# ─── Email (SMTP2GO) ─────────────────────────────────────────────
SMTP2GO_API_KEY=""
EMAIL_FROM=""
ADMIN_EMAIL=""

# ─── reCAPTCHA v3 ────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ─── Boletín (Brevo) ─────────────────────────────────────────────
BREVO_API_KEY=""
BREVO_LISTA_BOLETIN=""
BREVO_LISTA_PARTICIPANTES=""
BREVO_REMITENTE=""

# ─── Pasarela de pago (PowerTranz / BAC Credomatic) ──────────────
# Las credenciales las entrega FAC. Nunca se suben al repositorio.
POWERTRANZ_ID=""
POWERTRANZ_PASSWORD=""
# Pruebas:    https://staging.ptranz.com/api/spi
# Producción: https://gateway.ptranz.com/api/spi
POWERTRANZ_BASE_URL="https://staging.ptranz.com/api/spi"
POWERTRANZ_CURRENCY="840"
# Los crea FAC en el Portal del Comercio; hasta tenerlos no se puede cobrar
POWERTRANZ_PAGE_SET=""
POWERTRANZ_PAGE_NAME=""
# Antifraude Kount. Hoy la cuenta NO lo tiene aprovisionado: en "true" la
# pasarela responde FC3/1011 y ninguna transacción llega a abrirse.
POWERTRANZ_FRAUD_CHECK="false"
# Cobrar cuando 3DS responde "U" (falla técnica). En "true" el comercio
# pierde la protección ante contracargos: es una decisión de negocio.
POWERTRANZ_ACEPTAR_3DS_U="false"

# URL pública del sitio; con ella se arma el MerchantResponseUrl
NEXT_PUBLIC_SITE_URL=""

# SOLO PRUEBAS: permite simular el cobro sin pasarela para recorrer el flujo
# completo. Esta variable NO debe existir en producción.
POWERTRANZ_MODO_PRUEBA=""

# ─── Coffee Geeks Passport ───────────────────────────────────────
# Al aprobarse el pago de un producto marcado como "Activa el Pasaporte",
# se llama este servicio para crear la cuenta del comprador.
PASAPORTE_API_URL="https://passport.coffeegeekspanama.com/api/public/passport-sale"
PASAPORTE_API_KEY=""
